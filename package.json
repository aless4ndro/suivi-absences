{
  "name": "suivi-absences",
  "version": "0.1.0",
  "private": true,
  "description": "Suivi des absences, retards et rattrapages (BTS / licence en alternance)",
  "author": "Alessandro",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test electron/db.test.cjs",
    "dist": "npm run build && electron-builder --win portable --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "fr.alessandro.suiviabsences",
    "productName": "Suivi Absences",
    "directories": { "output": "release" },
    "files": ["dist/**", "electron/**", "!electron/**/*.test.cjs", "package.json"],
    "win": { "target": [{ "target": "portable", "arch": ["x64"] }] },
    "portable": { "artifactName": "SuiviAbsences.exe" }
  }
}
